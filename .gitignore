# 通用垃圾
node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store
*.swp
*~

# ZCode 会话本地工件(计划草稿等),不入库
.zcode/

# CodeGraph 本地代码图谱索引(工具工件,不入库)
.codegraph/

# 本地密钥与机敏文件,永不入库(基线 4.6 / INV-5;ADR-0010)
.secrets/*
!.secrets/example.env
perf_m9_run.txt
server.log

# 本机浏览器调试工件(Edge profile / playwright),不入库
.tools/

# 过程笔记暂存区(评审报告/对比/会话草稿等),交付即清——见 scripts/work_clean.sh
# 与 docs/doc-whitelist.txt:正式文档不落此处,此处内容随时可删,溯源 git 史
.work/

# W 系列 WebUI 壳子构建产物(源码在 runtime/webapp/src,构建入 dist)
runtime/webapp/node_modules/
runtime/webapp/dist/
# 包管理器唯一权威 = npm(package-lock.json);pnpm 误装残留防复发
runtime/webapp/pnpm-lock.yaml
runtime/webapp/pnpm-workspace.yaml
server-w.log

# 官方插件构建产物(源码在 plugins/mcp/*/src)
target/
target-review/
target-inspector/
plugins/mcp/web-multisearch/target/
plugins/mcp/context-inspector/target/
plugins/mcp/context-inspector/target-inspector/
server-w8.log

# 过夜/评审回归隔离目标目录(CARGO_TARGET_DIR=target-regress)
runtime/target-regress/

# 运行日志(本地排查用,不入库)
server-*.log

# 运行实测截图与浏览器档案(本地验收证据,不入库)
runtime/shots_*.png
runtime/shots-*/
runtime/playwright_profile/
runtime/server_*.log

# web-multisearch 隔离构建产物
target-wms/
plugins/mcp/web-multisearch/target-wms/
