{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BoenMind",
  "version": "0.1.4",
  "identifier": "com.boenmind.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BoenMind",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNTQ2NEM0REQ2OENDOTYKUldTV3pHamR4R1JVUDA5T1MyMjJPRThQK2RMbjJzVHpJaGNTSThaUnZ2STJLUVFZOGJENUhCUDgK",
      "endpoints": [
        "https://github.com/SadBoen/BoenMind/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}