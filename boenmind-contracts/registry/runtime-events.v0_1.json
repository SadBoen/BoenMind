{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "boenmind:registry:runtime-events:v0.1",
  "x-frozen": "2026-08-28",
  "title": "M1 运行时事件注册表",
  "description": "事件信封见 events 由 Event Log 统一写入：{event_seq(全局单调), type, occurred_at, correlation, payload}。M4 增发 approval.* / grant.* / capability.* / provider.binding.changed / bus.* 十类（Minor，纯追加）。",
  "events": [
    {
      "type": "runtime.started",
      "payload": {
        "pid": "integer",
        "version": "string",
        "started_at": "timestamp"
      }
    },
    {
      "type": "runtime.stopping",
      "payload": {
        "reason": "string"
      }
    },
    {
      "type": "runtime.stopped",
      "payload": {
        "uptime_ms": "integer"
      }
    },
    {
      "type": "session.created",
      "payload": {
        "session_id": "id",
        "agent_id": "id"
      }
    },
    {
      "type": "session.resumed",
      "payload": {
        "session_id": "id",
        "since_seq": "integer",
        "replayed": "integer"
      }
    },
    {
      "type": "session.closed",
      "payload": {
        "session_id": "id",
        "reason": "string"
      }
    },
    {
      "type": "agent.created",
      "payload": {
        "agent_id": "id",
        "session_id": "id",
        "model_chain": "string[]",
        "budget": "budget|null"
      }
    },
    {
      "type": "agent.started",
      "payload": {
        "agent_id": "id"
      }
    },
    {
      "type": "agent.turn.started",
      "payload": {
        "agent_id": "id",
        "operation_id": "id",
        "turn_index": "integer"
      }
    },
    {
      "type": "agent.waiting_model",
      "payload": {
        "agent_id": "id",
        "operation_id": "id",
        "model_id": "string"
      }
    },
    {
      "type": "agent.completed",
      "payload": {
        "agent_id": "id",
        "operation_id": "id",
        "turn_index": "integer",
        "content": "string"
      }
    },
    {
      "type": "agent.failed",
      "payload": {
        "agent_id": "id",
        "operation_id": "id",
        "error_code": "error_code"
      }
    },
    {
      "type": "agent.cancelled",
      "payload": {
        "agent_id": "id",
        "operation_id": "id"
      }
    },
    {
      "type": "agent.interrupted",
      "payload": {
        "agent_id": "id",
        "operation_id": "id",
        "reason": "string"
      }
    },
    {
      "type": "agent.resumed",
      "payload": {
        "agent_id": "id",
        "operation_id": "id"
      }
    },
    {
      "type": "operation.state.changed",
      "payload": {
        "operation_id": "id",
        "from": "state",
        "to": "state",
        "reason_code": "string"
      }
    },
    {
      "type": "model.invocation.completed",
      "payload": {
        "operation_id": "id",
        "agent_id": "id",
        "model_id": "string",
        "attempt": "integer",
        "usage_in": "integer",
        "usage_out": "integer",
        "latency_ms": "integer",
        "stream_interrupted": "boolean"
      }
    },
    {
      "type": "model.invocation.failed",
      "payload": {
        "operation_id": "id",
        "agent_id": "id",
        "model_id": "string",
        "attempt": "integer",
        "error_code": "error_code"
      }
    },
    {
      "type": "budget.warning",
      "payload": {
        "agent_id": "id",
        "scope": "string",
        "used_tokens": "integer",
        "limit_tokens": "integer",
        "ratio": "number"
      }
    },
    {
      "type": "budget.exceeded",
      "payload": {
        "agent_id": "id",
        "scope": "string",
        "used_tokens": "integer",
        "limit_tokens": "integer"
      }
    },
    {
      "type": "runtime.recovered",
      "payload": {
        "last_applied_seq": "integer",
        "replayed": "integer",
        "interrupted_recovered": "integer"
      }
    },
    {
      "type": "store.write.rejected",
      "payload": {
        "key": "string",
        "reason": "string"
      }
    },
    {
      "type": "approval.requested",
      "payload": {
        "approval_id": "id",
        "operation_id": "id",
        "capability": "string",
        "principal": "string",
        "risk_class": "string",
        "effective_risk": "string",
        "input_trust": "string",
        "expires_at": "timestamp"
      }
    },
    {
      "type": "approval.resolved",
      "payload": {
        "approval_id": "id",
        "operation_id": "id",
        "outcome": "string",
        "scope": "string|null",
        "grant_id": "id|null"
      }
    },
    {
      "type": "approval.expired",
      "payload": {
        "approval_id": "id",
        "operation_id": "id",
        "expired_at": "timestamp"
      }
    },
    {
      "type": "grant.created",
      "payload": {
        "grant_id": "id",
        "approval_id": "id",
        "audience": "string",
        "action": "string",
        "scope": "string",
        "delegation_depth": "integer",
        "expires_at": "timestamp|null",
        "parent_hash": "string"
      }
    },
    {
      "type": "grant.revoked",
      "payload": {
        "grant_id": "id",
        "revocation_version": "integer",
        "reason": "string"
      }
    },
    {
      "type": "capability.invoked",
      "payload": {
        "call_id": "id",
        "operation_id": "id",
        "capability": "string",
        "principal": "string",
        "binding_epoch": "integer",
        "provider_instance_id": "string",
        "outcome": "string",
        "error_code": "string|null",
        "idempotency_key_hash": "string|null"
      }
    },
    {
      "type": "capability.denied",
      "payload": {
        "call_id": "id",
        "capability": "string",
        "principal": "string",
        "input_trust": "string",
        "reason_code": "string"
      }
    },
    {
      "type": "provider.binding.changed",
      "payload": {
        "capability": "string",
        "provider_instance_id": "string",
        "old_epoch": "integer",
        "new_epoch": "integer",
        "reason": "string"
      }
    },
    {
      "type": "bus.degraded",
      "payload": {
        "reason": "string",
        "component": "string"
      }
    },
    {
      "type": "bus.resumed",
      "payload": {
        "component": "string",
        "degraded_ms": "integer"
      }
    }
  ],
  "payload_type_note": {
    "id": "wire/common 的 id 格式 <prefix>_<ULID26>",
    "timestamp": "ISO-8601 UTC",
    "state": "operation 状态机状态名",
    "error_code": "error-codes 注册表中的码"
  }
}
