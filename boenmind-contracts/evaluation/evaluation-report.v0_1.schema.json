{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "boenmind:evaluation:evaluation-report:v0.1",
  "x-frozen": "2026-08-30",
  "title": "评估报告 v0.1(M8.7)",
  "description": "独立 Judge 对事件日志区间的确定性评估产出。同输入恒同报告(可复跑);Judge 只读事件与收据,不依赖运行时内存态。LLM 定性注解为可选层,不进必填字段。",
  "type": "object",
  "required": [
    "report_id",
    "range",
    "checks",
    "summary",
    "judge_version",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "$ref": "boenmind:wire:envelope:v0.1#/definitions/id"
    },
    "range": {
      "type": "object",
      "required": [
        "from_seq",
        "to_seq"
      ],
      "additionalProperties": false,
      "properties": {
        "from_seq": {
          "type": "integer",
          "minimum": 1
        },
        "to_seq": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "verdict",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 2048,
            "description": "脱敏证据(INV-5):引用 seq/键,不携带原文"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "judge_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "$ref": "boenmind:wire:envelope:v0.1#/definitions/timestamp"
    }
  }
}
