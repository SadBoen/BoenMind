{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "boenmind:state-machines:core:v0.1",
  "x-frozen": "2026-08-28",
  "title": "M1 状态迁移表（Operation / Session / Agent / Task）",
  "description": "每次迁移必须产生一条 operation.state.changed（对 operation）或 task.state.changed（对 task，M5 起）并携带 reason_code。guard 是机器可检查的前置条件表达式。不在表中的迁移一律非法。terminal 列出的状态不可再迁出。M4 增发：operation.waiting_approval 状态与三条边（Minor）。M5 增发：task 状态机（7 态 12 边）与 agent.paused 态四边（Minor；completed 必须 guard verified_completion——无 Observation 核验不得完成，M5 规格 §5.7）。",
  "machines": {
    "operation": {
      "states": ["not_started", "running", "waiting_approval", "succeeded", "failed", "cancelled", "timeout", "outcome_unknown", "interrupted"],
      "terminal": ["succeeded", "failed", "cancelled", "timeout", "outcome_unknown"],
      "transitions": [
        { "from": "not_started",    "to": "running",         "guard": "dispatch_accepted" },
        { "from": "not_started",    "to": "cancelled",       "guard": "explicit_cancel_before_dispatch" },
        { "from": "running",        "to": "succeeded",       "guard": "result_recorded" },
        { "from": "running",        "to": "failed",          "guard": "error_terminal_and_no_external_effect_possible" },
        { "from": "running",        "to": "cancelled",       "guard": "explicit_cancel_and_no_external_effect_possible" },
        { "from": "running",        "to": "timeout",         "guard": "deadline_exceeded AND effect_class IN [read-only, low-risk-command]" },
        { "from": "running",        "to": "outcome_unknown", "guard": "(deadline_exceeded OR crash OR cancel) AND effect_class IN [reversible-command, external-side-effect, high-risk-command]" },
        { "from": "running",        "to": "interrupted",     "guard": "runtime_crash_before_terminal" },
        { "from": "running",        "to": "waiting_approval","guard": "approval_pending", "note": "M4 增发（基线 §9.6：等待审批的 Operation 处于 waiting_approval）" },
        { "from": "waiting_approval","to": "running",        "guard": "approval_granted", "note": "M4 增发" },
        { "from": "waiting_approval","to": "cancelled",      "guard": "approval_denied_or_expired_or_withdrawn", "note": "M4 增发；denied/expired 等价拒绝（基线 §9.6：denied → cancelled），无超时默认同意" },
        { "from": "interrupted",    "to": "running",         "guard": "recovery_replay_ok" },
        { "from": "interrupted",    "to": "cancelled",       "guard": "user_ruling" },
        { "from": "outcome_unknown","to": "succeeded",       "guard": "external_verification OR user_ruling", "note": "仅恢复流程可进入，禁止普通重试逻辑触发（基线 9.5/20）" },
        { "from": "outcome_unknown","to": "failed",          "guard": "external_verification OR user_ruling" }
      ]
    },
    "session": {
      "states": ["created", "active", "detached", "closed"],
      "terminal": ["closed"],
      "transitions": [
        { "from": "created",  "to": "active",   "guard": "surface_attached" },
        { "from": "active",   "to": "detached", "guard": "surface_disconnected", "note": "断开不取消进行中的 Operation（基线 7/14.2）" },
        { "from": "detached", "to": "active",   "guard": "session_resume" },
        { "from": "created",  "to": "closed",   "guard": "session_close" },
        { "from": "active",   "to": "closed",   "guard": "session_close" },
        { "from": "detached", "to": "closed",   "guard": "session_close" }
      ]
    },
    "agent": {
      "states": ["created", "starting", "running", "waiting_model", "paused", "stopping", "stopped", "failed", "cancelled", "interrupted", "resuming"],
      "terminal": ["stopped", "cancelled"],
      "m1_subset_note": "M5 已增发 paused（级联 task.pause/resume，规格 §5.5）；waiting_input/waiting_tool/waiting_approval 的 agent 侧状态仍随工具调用循环演进（审批等待当前由 operation.waiting_approval 承载），兑现顺序记入 M5 回看复核",
      "transitions": [
        { "from": "created",       "to": "starting",      "guard": "agent_start" },
        { "from": "created",       "to": "cancelled",     "guard": "explicit_cancel" },
        { "from": "starting",      "to": "running",       "guard": "model_binding_ready" },
        { "from": "starting",      "to": "failed",        "guard": "init_error" },
        { "from": "running",       "to": "waiting_model", "guard": "model_invoke_issued" },
        { "from": "waiting_model", "to": "running",       "guard": "model_response_ok" },
        { "from": "waiting_model", "to": "failed",        "guard": "model_chain_exhausted OR budget_exceeded" },
        { "from": "waiting_model", "to": "stopping",      "guard": "explicit_cancel" },
        { "from": "running",       "to": "stopping",      "guard": "explicit_cancel" },
        { "from": "running",       "to": "paused",        "guard": "task_paused OR agent_paused", "note": "M5 增发：用户 task.pause 级联或 Coordinator 显式 agent.pause（ADR-0002 mutation 动词）" },
        { "from": "paused",        "to": "running",       "guard": "task_resumed OR agent_resumed", "note": "M5 增发：用户 task.resume 级联（编排重启触发者之一，ADR-0004 条件 6）或 Coordinator agent.resume" },
        { "from": "paused",        "to": "stopping",      "guard": "explicit_cancel", "note": "M5 增发" },
        { "from": "paused",        "to": "cancelled",     "guard": "explicit_cancel", "note": "M5 增发" },
        { "from": "running",       "to": "failed",        "guard": "unrecoverable_error" },
        { "from": "stopping",      "to": "stopped",       "guard": "turn_boundary_reached" },
        { "from": "stopping",      "to": "interrupted",   "guard": "runtime_crash_during_stop" },
        { "from": "starting",      "to": "interrupted",   "guard": "runtime_crash" },
        { "from": "running",       "to": "interrupted",   "guard": "runtime_crash" },
        { "from": "waiting_model", "to": "interrupted",   "guard": "runtime_crash" },
        { "from": "interrupted",   "to": "resuming",      "guard": "restart_recovery" },
        { "from": "resuming",      "to": "running",       "guard": "replay_ok" },
        { "from": "resuming",      "to": "stopped",       "guard": "replay_ok AND turn_was_stopping" },
        { "from": "failed",        "to": "running",       "guard": "resend_after_failure", "note": "2026-09-03 增发：回合失败≠agent 死亡，用户同会话再次发消息即恢复接单（send_input 对 failed 自愈，发 agent.resumed）；failed 退出终态集" }
      ]
    },
    "task": {
      "states": ["created", "running", "paused", "blocked", "completed", "failed", "cancelled"],
      "terminal": ["completed", "failed", "cancelled"],
      "m5_note": "waiting_approval 不入 task 状态机（Operation/Agent 级承载）；Task 层以监护态投影呈现（基线 §20 八态，Observation Log 承载）。blocked 入口三因：budget_exhausted / stall_hard_limit / outcome_unknown_pending（M5 规格 §5.1/§5.2）",
      "transitions": [
        { "from": "created",  "to": "running",   "guard": "task_started" },
        { "from": "running",  "to": "paused",    "guard": "task_paused" },
        { "from": "paused",   "to": "running",   "guard": "task_resumed" },
        { "from": "running",  "to": "blocked",   "guard": "budget_exhausted OR stall_hard_limit OR outcome_unknown_pending" },
        { "from": "blocked",  "to": "running",   "guard": "user_resolved", "note": "含用户批准扩容/恢复裁定/副作用核验确认；blocked 不自动重启（ADR-0004 条件 6：硬顶后等待用户）" },
        { "from": "running",  "to": "completed", "guard": "verified_completion", "note": "完成判定门禁：无 Observation 核验不得完成（基线 M5 通过条件第 4 条；M5 规格 §5.7）" },
        { "from": "paused",   "to": "completed", "guard": "verified_completion" },
        { "from": "running",  "to": "failed",    "guard": "verified_failure" },
        { "from": "paused",   "to": "failed",    "guard": "verified_failure" },
        { "from": "running",  "to": "cancelled", "guard": "task_cancelled" },
        { "from": "paused",   "to": "cancelled", "guard": "task_cancelled" },
        { "from": "blocked",  "to": "cancelled", "guard": "task_cancelled" }
      ]
    }
  }
}
