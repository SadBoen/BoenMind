{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "boenmind:mcp:mcp-server:v0.1",
  "x-frozen": "2026-08-30",
  "title": "MCP Server 接入配置 v0.1",
  "description": "M7.2/M7.7:单个 MCP server 的安装声明。配置文件显式列出即视为用户安装批准(M7 规格 S6);env 一律 secret: 引用,明文不入配置(基线 4.6)。",
  "type": "object",
  "required": [
    "name",
    "transport",
    "command",
    "args"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "server 名,参与能力命名空间 mcp.<name>.<tool>;字符集与能力名段一致"
    },
    "transport": {
      "const": "stdio"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 32
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^secret:[A-Za-z0-9_.-]{1,64}$"
      },
      "description": "注入子进程的环境变量,值必须是 Secret Store 引用"
    },
    "tool_timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000
    },
    "restart_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "trust": {
      "enum": [
        "explicit-config"
      ],
      "description": "M7 仅接受显式配置安装;运行期动态注册随 Wire 面增发(M8)"
    }
  }
}
