# BoenMind 服务器版 systemd 服务
# 安装路径：/etc/systemd/system/boenmind.service
# 数据目录：/var/lib/boenmind（boenmind.db、settings、plugins 均在其下）
[Unit]
Description=BoenMind knowledge management server
After=network.target

[Service]
Type=simple
User=boenmind
Group=boenmind
# 前端静态资源目录：web-server --dist 指向打包内的 dist/
Environment=BOENMIND_DIST=/var/lib/boenmind/dist
# 监听所有网卡，局域网内浏览器直接访问 http://服务器IP:17321
ExecStart=/usr/local/bin/web-server --db /var/lib/boenmind/boenmind.db --dist /var/lib/boenmind/dist --port 17321 --bind 0.0.0.0
Restart=always
RestartSec=3
# 安全加固
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target