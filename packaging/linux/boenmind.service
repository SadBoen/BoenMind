# BoenMind 服务器版 systemd 服务
# 安装路径：/etc/systemd/system/boenmind.service
# 数据目录：/var/lib/boenmind（.boenmind 与 BoenMind 工作文件夹都在其下）
[Unit]
Description=BoenMind knowledge management server
After=network.target

[Service]
Type=simple
# 专用低权限用户，由 install.sh 创建
User=boenmind
Group=boenmind
# 数据目录：BOENMIND_HOME 覆盖默认的 ~（见 bm-core::config::home_base）
Environment=BOENMIND_HOME=/var/lib/boenmind
Environment=HOME=/var/lib/boenmind
# 公网只走 nginx 反代，本机回环监听
Environment=BOENMIND_BIND=127.0.0.1
# 反代域名：CSRF/CORS 放行同源 Origin（逗号分隔）
Environment=BOENMIND_PUBLIC_ORIGINS=https://bm.sadinsun.top
# 可选：BOENMIND_TOKEN 等敏感项放这里（文件不存在则忽略）
EnvironmentFile=-/etc/boenmind.env
ExecStart=/usr/local/bin/bm-server
Restart=always
RestartSec=3
# 安全加固（systemd 默认即可，这里显式收紧文件系统访问）
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
